# Copy to .env.secrets, fill in, run: python tools/set_secrets.py OWNER/REPO
# Leave a line empty to skip it. VAR_ prefix = repository variable.

# --- script generation (need at least one) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- stock footage (required) ---
PIXABAY_API_KEY=

# --- YouTube: paste the one-line JSON printed by tools/youtube_auth.py ---
YT_OAUTH_JSON=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# --- Instagram ---
IG_USER_ID=
IG_ACCESS_TOKEN=
VAR_IG_TOKEN_ISSUED=

# --- Healthchecks.io ping URLs (one check per slot) ---
HC_URL_10AM=
HC_URL_11AM=
HC_URL_10PM=
HC_URL_11PM=

# --- alerts (email and/or Slack) ---
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
SLACK_WEBHOOK_URL=

# --- optional ---
GH_PAT=
CATBOX_USERHASH=
VAR_PLATFORMS=youtube,tiktok,instagram
VAR_TIKTOK_MODE=inbox
VAR_YOUTUBE_PRIVACY=public
